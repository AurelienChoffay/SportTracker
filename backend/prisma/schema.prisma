generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  password        String
  firstName       String
  lastName        String
  dateOfBirth     DateTime?
  height          Float?    // en cm
  weight          Float?    // en kg
  profilePicture  String?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  workouts        Workout[]
  workoutPlans    WorkoutPlan[]
  nutritionLogs   NutritionLog[]
  sleepLogs       SleepLog[]
  goals           Goal[]
  
  @@index([email])
}

model Exercise {
  id              String    @id @default(uuid())
  name            String    @unique
  category        String    // Cardio, Force, Flexibilité, etc.
  muscleGroups    String[]  // Groupes musculaires ciblés
  equipment       String?   // Équipement nécessaire
  description     String?
  instructions    String?
  imageUrl        String?
  videoUrl        String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  workoutExercises WorkoutExercise[]
  
  @@index([category])
  @@index([name])
}

model Workout {
  id              String    @id @default(uuid())
  userId          String
  name            String
  date            DateTime
  duration        Int       // en minutes
  caloriesBurned  Int?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercises       WorkoutExercise[]
  
  @@index([userId, date])
}

model WorkoutExercise {
  id              String    @id @default(uuid())
  workoutId       String
  exerciseId      String
  sets            Int
  reps            Int[]     // Array des répétitions par set
  weight          Float[]   // Array des poids par set (en kg)
  distance        Float?    // Pour cardio (en km)
  duration        Int?      // Pour cardio (en minutes)
  restTime        Int?      // Temps de repos entre sets (en secondes)
  notes           String?
  
  workout         Workout   @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercise        Exercise  @relation(fields: [exerciseId], references: [id])
  
  @@index([workoutId])
  @@index([exerciseId])
}

model WorkoutPlan {
  id              String    @id @default(uuid())
  userId          String
  name            String
  description     String?
  goal            String?   // Prise de masse, Perte de poids, etc.
  difficulty      String    // Débutant, Intermédiaire, Avancé
  durationWeeks   Int
  daysPerWeek     Int
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
}

model NutritionLog {
  id              String    @id @default(uuid())
  userId          String
  date            DateTime
  meal            String    // Petit-déjeuner, Déjeuner, Dîner, Collation
  foodName        String
  quantity        Float
  unit            String    // g, ml, portion, etc.
  calories        Float
  protein         Float     // en g
  carbs           Float     // en g
  fat             Float     // en g
  fiber           Float?    // en g
  sugar           Float?    // en g
  sodium          Float?    // en mg
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId, date])
}

model SleepLog {
  id              String    @id @default(uuid())
  userId          String
  date            DateTime
  bedTime         DateTime
  wakeTime        DateTime
  duration        Float     // en heures
  quality         Int       // 1-10
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId, date])
}

model Goal {
  id              String    @id @default(uuid())
  userId          String
  title           String
  description     String?
  category        String    // Poids, Performance, Nutrition, etc.
  targetValue     Float
  currentValue    Float
  unit            String    // kg, répétitions, km, etc.
  targetDate      DateTime
  isAchieved      Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
}